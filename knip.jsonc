{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/**", "web/src/client/**"],
  "ignoreIssues": {
    "web/src/components/ui/**": ["exports", "types"],
  },
  "ignoreDependencies": ["@typespec/http", "@typespec/openapi", "@typespec/openapi3"],
  "ignoreBinaries": ["hk", "jactionlint", "vacuum"],
}
